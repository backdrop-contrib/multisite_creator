<?php
/**
 * @file
 * Module to create new Backdrop multisite sites automatically.
 */

require_once(__DIR__ . '/multisite_creator.admin.inc');
require_once(__DIR__ . '/multisite_creator.cron.inc');
require_once(__DIR__ . '/multisite_creator.install.inc');
require_once(__DIR__ . '/multisite_creator.mail.inc');
require_once(__DIR__ . '/multisite_creator.ssl.inc');

/**
 * Implements hook_menu().
 */
