<?php

/**
 * @file
 * Functions for sending email notifications.
 */

/**
 * Sends notification for new site creation.
 *
 * @param array $site_data
 *   Data of the created site.
 * @param string $site_url
 *   URL of the new site.
 */
function multisite_creator_send_creation_notification($site_data, $site_url) {
  $config = config('multisite_creator.settings');

  $notification_emails = $config->get('notification_emails');
  if (empty($notification_emails)) {
    return FALSE;
  }

  $emails = multisite_creator_parse_email_list($notification_emails);
  $from_email = $config->get('email_from');

  // Get email template
  $template = $config->get('email_template');
  if (empty($template)) {
    $template = multisite_creator_default_email_template();
  }

  // Prepare replacements
  $replacements = array(
    '{SITE_NAME}' => $site_data['name'],
    '{MACHINE_NAME}' => $site_data['machine_name'],
    '{URL}' => $site_url,
    '{ADMIN_EMAIL}' => $site_data['user1_email'],
    '{ADMIN_USERNAME}' => $site_data['user1_name'],
    '{DATE}' => date('Y-m-d H:i:s'),
    '{HOST}' => $_SERVER['HTTP_HOST'],
  );

  // Replace variables in template
  $body = str_replace(array_keys($replacements), array_values($replacements), $template);

  // Prepare subject
  $subject = t('New site created: @name', array('@name' => $site_data['name']));

  // Send email to all recipients
  $sent_count = 0;
  foreach ($emails as $email) {
    if (multisite_creator_send_email($email, $from_email, $subject, $body)) {
      $sent_count++;
    }
  }

  if ($sent_count > 0) {
    watchdog(
      'multisite_creator',
      'Creation notification sent to @count recipients for site @site',
      array('@count' => $sent_count, '@site' => $site_data['name'])
    );
  }

  return $sent_count > 0;
}

/**
 * Sends error notification during creation.
 *
 * @param array $site_data
 *   Data of the failed site.
 * @param string $error_message
 *   Error message.
 */
function multisite_creator_send_error_notification($site_data, $error_message) {
  global $user;
  $config = config('multisite_creator.settings');

  $notification_emails = $config->get('notification_emails');
  if (empty($notification_emails)) {
    return FALSE;
  }

  $emails = multisite_creator_parse_email_list($notification_emails);
  $from_email = $config->get('email_from');

  // Prepare email content
  $subject = t('ERROR: Failed creating site @name', array('@name' => $site_data['name']));

  $message = array();
  $message[] = t('There was an error creating a new multisite website:');
  $message[] = '';
  $message[] = t('Site name: @name', array('@name' => $site_data['name']));
  $message[] = t('Machine name: @machine', array('@machine' => $site_data['machine_name']));
  $message[] = t('Administrator email: @email', array('@email' => $site_data['user1_email']));
  $message[] = '';
  $message[] = t('ERROR MESSAGE:');
  $message[] = $error_message;
  $message[] = '';
  $message[] = t('Error date: @date', array('@date' => date('Y-m-d H:i:s')));
  $message[] = t('Server: @host', array('@host' => $_SERVER['HTTP_HOST']));
  $message[] = t('User IP: @ip', array('@ip' => $_SERVER['REMOTE_ADDR']));

  // Add technical information
  $message[] = '';
  $message[] = t('TECHNICAL INFORMATION:');
  $message[] = t('User: @user', array('@user' => $user ? $user->name : 'Anonymous'));
  $message[] = t('User Agent: @ua', array('@ua' => $_SERVER['HTTP_USER_AGENT']));

  $message[] = '';
  $message[] = t('Check system logs for more details:');
  $message[] = url('admin/reports/dblog', array('absolute' => TRUE));

  $message[] = '';
  $message[] = t('--');
  $message[] = t('This email was automatically generated by the Multisite Creator module.');

  $body = implode("\n", $message);

  // Send email to all recipients
  $sent_count = 0;
  foreach ($emails as $email) {
    if (multisite_creator_send_email($email, $from_email, $subject, $body)) {
      $sent_count++;
    }
  }

  if ($sent_count > 0) {
    watchdog(
      'multisite_creator',
      'Error notification sent to @count recipients for site @site',
      array('@count' => $sent_count, '@site' => $site_data['name'])
    );
  }

  return $sent_count > 0;
}



/**
 * Sends an email.
 *
 * @param string $to
 *   Recipient.
 * @param string $from
 *   Sender.
 * @param string $subject
 *   Subject.
 * @param string $body
 *   Message body.
 *
 * @return bool
 *   TRUE if sent successfully.
 */
function multisite_creator_send_email($to, $from, $subject, $body) {
  $params = array(
    'subject' => $subject,
    'body' => $body,
  );

  $message = backdrop_mail('multisite_creator', 'notification', $to, language_default(), $params, $from);

  return $message['result'];
}

/**
 * Parses a comma-separated list of emails.
 */
function multisite_creator_parse_email_list($email_list) {
  $emails = preg_split('/[,\s]+/', trim($email_list));
  $valid_emails = array();

  foreach ($emails as $email) {
    $email = trim($email);
    if (valid_email_address($email)) {
      $valid_emails[] = $email;
    }
  }

  return $valid_emails;
}

/**
 * Implements hook_mail().
 */
function multisite_creator_mail($key, &$message, $params) {
  switch ($key) {
    case 'notification':
      $message['subject'] = $params['subject'];
      $message['body'][] = $params['body'];
      break;
  }
}


/**
 * Sends weekly activity summary.
 */
function multisite_creator_send_weekly_summary() {
  $config = config('multisite_creator.settings');

  if (!$config->get('email_notifications')) {
    return FALSE;
  }

  $notification_emails = $config->get('notification_emails');
  if (empty($notification_emails)) {
    return FALSE;
  }

  // Gather statistics from the past week
  $week_ago = time() - (7 * 24 * 60 * 60);

  // Count sites created this week (simplified)
  $query = db_select('watchdog', 'w');
  $query->condition('type', 'multisite_creator');
  $query->condition('message', 'New site created:%', 'LIKE');
  $query->condition('timestamp', $week_ago, '>');
  $sites_created = $query->countQuery()->execute()->fetchField();

  // Count errors
  $query = db_select('watchdog', 'w');
  $query->condition('type', 'multisite_creator');
  $query->condition('severity', WATCHDOG_ERROR);
  $query->condition('timestamp', $week_ago, '>');
  $errors = $query->countQuery()->execute()->fetchField();

  if ($sites_created == 0 && $errors == 0) {
    return FALSE; // No activity
  }

  $emails = multisite_creator_parse_email_list($notification_emails);
  $from_email = $config->get('email_from');

  // Prepare content
  $subject = t('Weekly summary - Multisite Creator');

  $message = array();
  $message[] = t('Activity summary for the last 7 days:');
  $message[] = '';
  $message[] = t('Sites created: @count', array('@count' => $sites_created));
  $message[] = t('Errors: @count', array('@count' => $errors));
  $message[] = '';
  $message[] = t('Summary date: @date', array('@date' => date('Y-m-d H:i:s')));
  $message[] = '';
  $message[] = t('--');
  $message[] = t('This email was automatically generated by the Multisite Creator module.');

  $body = implode("\n", $message);

  // Send email
  $sent_count = 0;
  foreach ($emails as $email) {
    if (multisite_creator_send_email($email, $from_email, $subject, $body)) {
      $sent_count++;
    }
  }

  return $sent_count > 0;
}
